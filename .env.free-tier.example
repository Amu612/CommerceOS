# CommerceOS — free-tier EC2 deployment config.
# Copy to `.env.free-tier` ON THE EC2 BOX ONLY (never commit it — it holds
# real credentials). docker-compose.free-tier.yml reads it with --env-file.
# See docs/deploy-free-tier.md.

# ── Database (RDS free tier — db.t3.micro, single-AZ) ───────
# From the RDS console: your instance's "Endpoint" + the master
# username/password you set when creating it.
DATABASE_URL=postgresql://commerceos_app:CHANGE_ME@commerceos-db.xxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/commerceos

# ── Cache (ElastiCache free tier — cache.t3.micro) ───────────
# Leave REDIS_ENABLED=false to skip Redis entirely (the app degrades
# gracefully without it — see backend/app/core/redis.py). Set both if you
# created the free-tier Redis node too.
REDIS_ENABLED=false
REDIS_URL=redis://commerceos-redis.xxxxxx.cache.amazonaws.com:6379/0

# ── Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS
SEED_ADMIN_PASSWORD=CHANGE_ME_A_REAL_PASSWORD

# ── Public URLs — your EC2 Elastic IP (or domain, once you have one) ──
PUBLIC_URL=http://YOUR_ELASTIC_IP
PUBLIC_API_URL=http://YOUR_ELASTIC_IP:8000
PUBLIC_WS_URL=ws://YOUR_ELASTIC_IP:8000

# ── LLM (optional) — deterministic needs no key and costs nothing ────
LLM_PROVIDER=deterministic
# LLM_PROVIDER=groq
# GROQ_API_KEY=            # free at console.groq.com

# ── Datasets — S3 bucket you uploaded backend/data/raw/ into ────────
DATASET_DIR=s3://commerceos-datasets-YOUR-ACCOUNT-ID/raw

# Keep auth soft-enforced until you're ready to require login (matches
# local dev default — see docs/gap-analysis.md).
AUTH_ENFORCED=false
