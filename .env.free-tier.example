# ============================================================
# CommerceOS — AWS Free Plan / Single EC2 Configuration
# ============================================================

# ------------------------------------------------------------
# PostgreSQL — runs inside Docker on the EC2 instance
# ------------------------------------------------------------
POSTGRES_DB=commerceos
POSTGRES_USER=commerceos
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ------------------------------------------------------------
# Application security
# ------------------------------------------------------------
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SEED_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD

# ------------------------------------------------------------
# Backend
# ------------------------------------------------------------
BACKEND_WORKERS=1

# ------------------------------------------------------------
# Redis — runs inside Docker on the EC2 instance
# ------------------------------------------------------------
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------
# AI / LLM
# ------------------------------------------------------------
# Groq (https://console.groq.com) powers the dynamic ReAct agents.
# Set the real key ONLY in this file on the EC2 instance — it is git-ignored
# and must never be committed or baked into an image.
LLM_PROVIDER=groq
# Any Groq chat model your account can call (openai/gpt-oss-120b default).
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------
# Public URLs
# ------------------------------------------------------------
# These will be changed to your EC2 public IP after EC2 is created.
PUBLIC_URL=http://YOUR_EC2_PUBLIC_IP
PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP:8000
PUBLIC_WS_URL=ws://YOUR_EC2_PUBLIC_IP:8000

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
AUTH_ENFORCED=false

# ------------------------------------------------------------
# Dataset
# ------------------------------------------------------------
DATASET_DIR=/app/data/raw

# ------------------------------------------------------------
# Optional integrations
# ------------------------------------------------------------
TOMTOM_API_KEY=
APIFY_API_TOKEN=
