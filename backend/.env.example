# CommerceOS / Nexus — backend configuration
# Copy to `.env` for local dev. In cloud, these come from AWS Secrets Manager / SSM.

# ── Identity ─────────────────────────────────────────────
ENVIRONMENT=development           # development | production | test
PROJECT_NAME=CommerceOS AI
PORT=8000
WORKERS=2

# ── Database ─────────────────────────────────────────────
# Local (compose): postgresql://postgres:postgres@postgres:5432/commerceos
# Pre-M2 fallback: leave blank to use the bundled SQLite file.
DATABASE_URL=
# Optional read replica / read-only role (analytics agent, heavy dashboards).
DATABASE_READ_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=false

# ── Auth / security ──────────────────────────────────────
JWT_SECRET=change-me-32+chars-random
JWT_TTL_MINUTES=720
SEED_ADMIN_PASSWORD=CommerceOS2024!
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_HOSTS=*
RATE_LIMIT_PER_MINUTE=240
EXPOSE_DOCS=true

# ── LLM provider ─────────────────────────────────────────
# deterministic (no external calls) | openai | anthropic | bedrock
LLM_PROVIDER=deterministic
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_REQUEST_TOKEN_BUDGET=6000
LLM_MONTHLY_BUDGET_USD=200
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── Data / ingestion ─────────────────────────────────────
# Local dir with the Olist + DataCo CSVs, or s3://bucket/prefix
DATASET_DIR=
REPLAY_MAX_ORDERS=15000

# historic | live_shopify — falls back to historic if Shopify isn't configured
DATA_SOURCE=historic

# ── Shopify (live data source) ───────────────────────────
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2024-10
SHOPIFY_WEBHOOK_SECRET=
# Preferred (Dev Dashboard apps): client-credentials grant — the backend
# exchanges these for a 24h token itself and refreshes it automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Legacy fallback: a static token from an admin-created custom app. Only
# used if the client id/secret above aren't set.
SHOPIFY_ADMIN_TOKEN=

# ── Apify (competitor price feed, Pricing agent only) ────
APIFY_TOKEN=
APIFY_ACTOR_ID=
PRICING_COMPETITOR_FEED_ENABLED=false

# ── Observability ────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
