# CommerceOS — backend configuration
# Copy to `.env` for local dev. In cloud, these come from AWS Secrets Manager / SSM.

# ── Identity ─────────────────────────────────────────────
ENVIRONMENT=development           # development | production | test
PROJECT_NAME=CommerceOS AI
PORT=8000
WORKERS=2

# ── Database ─────────────────────────────────────────────
# Local (compose): postgresql://postgres:postgres@postgres:5432/commerceos
# Pre-M2 fallback: leave blank to use the bundled SQLite file.
DATABASE_URL=
# Optional read replica / read-only role (analytics agent, heavy dashboards).
DATABASE_READ_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=false

# ── Auth / security ──────────────────────────────────────
JWT_SECRET=change-me-32+chars-random
JWT_TTL_MINUTES=720
SEED_ADMIN_PASSWORD=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_HOSTS=*
RATE_LIMIT_PER_MINUTE=240
EXPOSE_DOCS=true

# ── LLM provider ─────────────────────────────────────────
# auto | deterministic (no external calls) | groq | openai | anthropic | bedrock
LLM_PROVIDER=auto
LLM_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
ANTHROPIC_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# ── AWS credentials (optional for local S3 dataset sync/Bedrock) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Data / ingestion ─────────────────────────────────────
# Local dir with the Olist + DataCo CSVs, or s3://bucket/prefix
DATASET_DIR=
REPLAY_MAX_ORDERS=15000

# ── Apify (competitor price feed, Pricing agent only) ────
APIFY_TOKEN=
APIFY_ACTOR_ID=
PRICING_COMPETITOR_FEED_ENABLED=false

# ── Observability ────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# TomTom Routing (Logistics route intelligence). Optional — OSRM fallback is keyless.
TOMTOM_API_KEY=
