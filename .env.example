# ═════════════════════════════════════════════════════════════════
# CommerceOS — Environment Variables Template
# Copy to `.env` or set these in your deployment environment / secrets manager.
# NEVER commit real credentials or secrets to version control.
# ═════════════════════════════════════════════════════════════════

# ── General & Server ─────────────────────────────────────────────
ENVIRONMENT=development
PROJECT_NAME=CommerceOS AI
PORT=8000
WORKERS=2
LOG_LEVEL=INFO
LOG_JSON=true

# ── Database (PostgreSQL) ────────────────────────────────────────
# Local (docker-compose): postgresql://postgres:postgres@localhost:5432/commerceos
# Leave empty to fall back to local SQLite database in dev
DATABASE_URL=
DATABASE_READ_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Redis (Event Bus, Caching & Realtime Stream) ──────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ── Security & Authentication ────────────────────────────────────
# Generate a strong 32+ character secret for production (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-32+chars-random
JWT_TTL_MINUTES=720
SEED_ADMIN_PASSWORD=change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUSTED_HOSTS=*
RATE_LIMIT_PER_MINUTE=240
EXPOSE_DOCS=true

# ── LLM Providers (Groq / OpenAI / Anthropic / AWS Bedrock) ──────
# Options: auto | deterministic | groq | openai | anthropic | bedrock
LLM_PROVIDER=auto
LLM_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
ANTHROPIC_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
LLM_TIMEOUT_SECONDS=20
LLM_REQUEST_TOKEN_BUDGET=6000
LLM_MONTHLY_BUDGET_USD=200

# ── AWS Credentials (for S3 dataset sync / Bedrock / Terraform) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Logistics & External Integrations ────────────────────────────
# TomTom Routing API key (optional — OSRM keyless fallback is used if not set)
TOMTOM_API_KEY=

# Apify (Competitor Price Feed — optional)
APIFY_TOKEN=
APIFY_ACTOR_ID=
PRICING_COMPETITOR_FEED_ENABLED=false

# ── Frontend Configuration (Vite) ────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
