# Copy to .env.aws on the EC2 host and fill in. Used with:
#   docker compose -f docker-compose.aws.yml --env-file .env.aws up -d --build
# See docs/deploy-aws-free-tier.md for how each value is produced.

# From the RDS console/CLI (endpoint) + the master password you set when creating it.
DATABASE_URL=postgresql://commerceos_app:<db-password>@<rds-endpoint>:5432/commerceos

# From the ElastiCache console/CLI (primary endpoint). No auth token in this
# no-NAT, no-TLS free-tier setup — the Redis security group only allows the
# EC2 instance's own security group in, see the guide.
REDIS_URL=redis://<elasticache-endpoint>:6379/0

# openssl rand -hex 32
JWT_SECRET=

SEED_ADMIN_PASSWORD=change-me-in-production

# This instance's Elastic IP (or public DNS) — baked into the frontend build
# and used for CORS. http://, not https:// (no ACM cert in this guide).
PUBLIC_URL=http://<your-elastic-ip>
PUBLIC_WS_URL=ws://<your-elastic-ip>

# deterministic | groq | openai
LLM_PROVIDER=deterministic
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Leave at 1 on a t2/t3.micro (1 GB RAM). Bump to 2 only on a bigger instance.
BACKEND_WORKERS=1
